<.form for={@email_form} phx-submit="update_email" id="update_email">
  <div class="shadow-sm dark:shadow-gray-900/50 rounded-md overflow-hidden">
    <div class="bg-white dark:bg-gray-800 p-6 space-y-6">
      <div>
        <h3 class="text-lg leading-6 font-medium text-gray-900 dark:text-gray-100">Email</h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
          Update your email. All emails to your aliases will be sent here!
        </p>
      </div>
      <div class="grid grid-cols-3 gap-x-6">
        <div class="col-span-3">
          <.input field={@email_form[:email]} label="Email" type="email" required />
        </div>
        <div class="col-span-3 mt-6">
          <.input
            field={@email_form[:current_password]}
            label="Current password"
            type="password"
            name="current_password"
            id="current_password_for_email"
            autocomplete="current-password"
            required
          />
        </div>
      </div>
      <div class="text-right">
        <.button type="submit" phx-disable-with="Sending…" text="Change email" />
      </div>
    </div>
  </div>
</.form>

<.form
  for={@email_preferences_form}
  phx-submit="update_email_preferences"
  id="email-preferences-form"
  class="mt-6"
>
  <div class="shadow-sm dark:shadow-gray-900/50 rounded-md overflow-hidden">
    <div class="bg-white dark:bg-gray-800 p-6 space-y-6">
      <div>
        <h3 class="text-lg leading-6 font-medium text-gray-900 dark:text-gray-100">
          Email branding
        </h3>
        <p id="email-branding-description" class="mt-1 text-sm text-gray-500 dark:text-gray-400">
          Show a Shroud.email footer in emails and “via Shroud.email” in sender names. Turning this off does not affect tracker removal or private reply addresses.
        </p>
      </div>
      <div>
        <input type="hidden" name={@email_preferences_form[:email_branding].name} value="false" />
        <label
          for="user_email_branding"
          class="flex items-center gap-3 text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          <input
            type="checkbox"
            id="user_email_branding"
            name={@email_preferences_form[:email_branding].name}
            value="true"
            checked={
              Phoenix.HTML.Form.normalize_value(
                "checkbox",
                @email_preferences_form[:email_branding].value
              )
            }
            aria-describedby="email-branding-description"
            class="rounded-sm border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:bg-gray-700 dark:border-gray-600"
          /> Show Shroud.email branding
        </label>
        <span
          :for={error <- @email_preferences_form[:email_branding].errors}
          class="invalid-feedback"
        >
          {translate_error(error)}
        </span>
      </div>
      <div class="text-right">
        <.button type="submit" phx-disable-with="Saving…" text="Save preferences" />
      </div>
    </div>
  </div>
</.form>

<section
  id="danger-zone"
  aria-labelledby="danger-zone-title"
  class="rounded-md border border-red-200 bg-white p-6 dark:border-red-900 dark:bg-gray-800"
>
  <h3 id="danger-zone-title" class="text-lg font-medium text-red-700 dark:text-red-400">
    Danger zone
  </h3>
  <h4 class="mt-4 text-sm font-medium text-gray-900 dark:text-gray-100">Delete account</h4>
  <p id="delete-account-warning" class="mt-1 text-sm text-gray-500 dark:text-gray-400">
    Permanently delete your account, aliases, custom domains, and stored spam. Your aliases will
    stop forwarding email, and all sessions and connected apps will lose access. This cannot be undone.
  </p>
  <p id="delete-account-billing-warning" class="mt-3 text-sm text-gray-500 dark:text-gray-400">
    Any subscription will be cancelled immediately. Deleting your account does not issue a refund,
    including for unused subscription time.
  </p>
  <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
    Shared alias addresses stay reserved so nobody else can use them.
  </p>
  <.form
    for={@deletion_form}
    id="delete-account-form"
    action={~p"/settings/account"}
    method="delete"
    class="mt-6 space-y-4"
    aria-describedby="delete-account-warning delete-account-billing-warning"
  >
    <div>
      <.input
        field={@deletion_form[:current_password]}
        name="current_password"
        id="delete-account-password"
        label="Current password"
        type="password"
        autocomplete="current-password"
        aria-invalid={to_string(@flash["deletion_password_error"] != nil)}
        aria-describedby={
          if @flash["deletion_password_error"], do: "delete-account-password-error"
        }
        required
      />
      <p
        :if={@flash["deletion_password_error"]}
        id="delete-account-password-error"
        role="alert"
        class="mt-2 text-sm text-red-600 dark:text-red-400"
      >
        {@flash["deletion_password_error"]}
      </p>
    </div>
    <label class="flex items-start gap-3 text-sm text-gray-700 dark:text-gray-300">
      <input
        id="confirm-account-deletion"
        type="checkbox"
        name="confirm_deletion"
        value="true"
        required
        class="mt-0.5 rounded-sm border-gray-300 text-red-600 focus:ring-red-500 dark:bg-gray-700 dark:border-gray-600"
      />
      <span>I understand that deletion is permanent and does not issue a refund.</span>
    </label>
    <div class="text-right">
      <.button
        id="delete-account-button"
        type="submit"
        intent={:danger}
        text="Permanently delete account"
      />
    </div>
  </.form>
</section>
