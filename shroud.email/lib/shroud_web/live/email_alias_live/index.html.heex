<.alert
  :if={@current_user.status == :free}
  title="Free plan"
  type={:info}
  icon={:information_circle}
>
  You're on the free plan ({@alias_count}/5 aliases used).
  <.link href={~p"/settings/billing"} class="underline font-medium">Upgrade</.link>
  for unlimited aliases, custom domains, and outgoing email.
</.alert>

<form id="custom-alias-form" phx-submit="create_custom_alias">
  <.live_component
    module={PopupAlert}
    id="add_alias_modal"
    title="New alias"
    text="What should your new alias be?"
    icon={:envelope}
  >
    <div class="mt-2">
      <div class="flex items-center">
        <.text_input name="alias_name" placeholder="john.doe" value={@custom_alias_name} />
        <span class="ml-3 text-sm text-gray-700 dark:text-gray-300">{@custom_alias_domain}</span>
      </div>
      <div class="mt-2">
        <.button
          id="generate-alias-name"
          click="generate_alias_name"
          text="Generate random alias"
          intent={:secondary}
        />
      </div>
      <p :if={@custom_alias_error} class="text-red-600 mt-1 text-sm">
        {@custom_alias_error}
      </p>
    </div>
    <:buttons>
      <.button text="Create" type="submit" />
    </:buttons>
  </.live_component>
</form>

<%= if @filtered_alias_count == 0 and @filter_query == "" do %>
  <.empty_state
    title="No aliases yet"
    description="Get started by adding your first alias."
    icon={:envelope}
  >
    <%= if @at_free_limit do %>
      <div x-init x-tooltip.raw="Upgrade to create more aliases">
        <.button text="New alias" icon={:plus} disabled={true} />
      </div>
    <% else %>
      <.button click="add_alias" text="New alias" icon={:plus} />
    <% end %>
  </.empty_state>
<% else %>
  <div class="mb-3 flex items-center justify-between">
    <div class="text-gray-600 dark:text-gray-400 text-sm hidden sm:block">
      {@filtered_alias_count}
      <%= if @filtered_alias_count == 1 do %>
        alias
      <% else %>
        aliases
      <% end %>
    </div>

    <div class="flex flex-col-reverse sm:flex-row items-center w-full sm:w-fit">
      <div class="sm:mr-3 sm:mt-0 mt-3 w-full sm:w-fit">
        <form id="alias-search" phx-change="filter" phx-submit="filter">
          <label for="query" class="sr-only">Search aliases</label>
          <input
            phx-debounce="300"
            value={@filter_query}
            type="text"
            name="query"
            id="query"
            class="shadow-xs focus:ring-indigo-500 focus:border-indigo-500 block w-full text-sm border-gray-300 dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100 dark:placeholder-gray-400 px-4 rounded-full"
            placeholder="Search aliases"
          />
          <button type="submit" class="sr-only">Search aliases</button>
        </form>
      </div>
      <%= if @at_free_limit do %>
        <div x-init x-tooltip.raw="Upgrade to create more aliases">
          <.button text="New alias" icon={:plus} disabled={true} />
        </div>
      <% else %>
        <%= if Enum.empty?(@custom_domains) do %>
          <.button click="add_alias" text="New alias" icon={:plus} />
        <% else %>
          <.button_with_dropdown click="add_alias" text="New alias" icon={:plus}>
            <.dropdown_item index={0} click="add_alias" text={"@#{Util.email_domain()}"} />
            <.dropdown_item
              :for={{domain, index} <- Enum.with_index(@custom_domains, 1)}
              index={index}
              click="open_custom_alias_modal"
              text={"@#{domain.domain}"}
            />
          </.button_with_dropdown>
        <% end %>
      <% end %>
    </div>
  </div>
  <.empty_state
    :if={@filtered_alias_count == 0}
    title="No matching aliases"
    description="Try a different search or clear it to see all your aliases."
    icon={:envelope}
  >
    <.button id="clear-alias-search" click="filter" text="Clear search" phx-value-query="" />
  </.empty_state>
  <div :if={@filtered_alias_count > 0} class="flex flex-col">
    <div class="-my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8">
        <div class="shadow-sm dark:shadow-gray-900/50 overflow-hidden border-b border-gray-200 dark:border-gray-700 sm:rounded-lg">
          <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-700">
              <tr>
                <th
                  scope="col"
                  class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider sm:px-6"
                >
                  Address
                </th>
                <th
                  scope="col"
                  class="hidden px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider sm:table-cell"
                >
                  Forwarded
                </th>
                <th
                  scope="col"
                  class="hidden px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider lg:table-cell"
                >
                  Status
                </th>
                <th
                  scope="col"
                  class="hidden px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider sm:table-cell"
                >
                  Created
                </th>
                <th scope="col" class="relative px-4 py-3 sm:px-6">
                  <span class="sr-only">Edit</span>
                </th>
              </tr>
            </thead>
            <tbody
              id="aliases"
              phx-update="stream"
              class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700"
            >
              <tr :for={{id, email_alias} <- @streams.aliases} id={id}>
                <td class="px-4 py-4 whitespace-nowrap sm:px-6">
                  <div>
                    <dl class="text-sm lg:hidden">
                      <dt class="sr-only">Status</dt>
                      <dd class="mt-1 truncate text-gray-700 dark:text-gray-300">
                        <%= if email_alias.enabled do %>
                          <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300">
                            Enabled
                          </span>
                        <% else %>
                          <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300">
                            Disabled
                          </span>
                        <% end %>
                      </dd>
                    </dl>
                    <div class="flex items-center">
                      <.link
                        navigate={~p"/alias/#{email_alias.address}"}
                        class="text-sm font-medium text-gray-900 dark:text-gray-100 hover:text-gray-500 dark:hover:text-gray-400"
                      >
                        {email_alias.address}
                      </.link>
                      <.copy_to_clipboard_button
                        id={"copy-alias-#{email_alias.id}"}
                        class="ml-1"
                        text={email_alias.address}
                      />
                    </div>
                    <div class="text-sm text-gray-500 dark:text-gray-400">
                      {email_alias.title}
                    </div>
                    <dl class="text-sm lg:hidden">
                      <dt class="sr-only sm:hidden">Forwarded</dt>
                      <dd class="mt-1 truncate text-gray-500 dark:text-gray-400 sm:hidden">
                        {email_alias.forwarded} forwarded
                      </dd>
                    </dl>
                  </div>
                </td>
                <td class="hidden px-6 py-4 whitespace-nowrap sm:table-cell">
                  <div class="text-sm text-gray-900 dark:text-gray-100">
                    {email_alias.forwarded}
                  </div>
                  <div class="text-sm text-gray-500 dark:text-gray-400">
                    {email_alias.forwarded_in_last_30_days} in the last month
                  </div>
                </td>
                <td class="hidden px-6 py-4 whitespace-nowrap lg:table-cell">
                  <%= if email_alias.enabled do %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300">
                      Enabled
                    </span>
                  <% else %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300">
                      Disabled
                    </span>
                  <% end %>
                </td>
                <td class="hidden px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400 sm:table-cell">
                  {Timex.format!(email_alias.inserted_at, "{ISOdate}")}
                </td>
                <td class="px-4 py-4 whitespace-nowrap text-right text-sm font-medium sm:px-6">
                  <.link
                    navigate={~p"/alias/#{email_alias.address}"}
                    class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-900 dark:hover:text-indigo-300"
                  >
                    Edit
                  </.link>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <nav
      :if={@total_pages > 1}
      id="alias-pagination"
      aria-label="Alias pagination"
      class="mt-4 flex items-center justify-between gap-3 text-sm"
    >
      <p
        id="alias-page-range"
        aria-live="polite"
        aria-atomic="true"
        class="hidden sm:block text-gray-600 dark:text-gray-400"
      >
        Showing {(@page_number - 1) * @page_size + 1}–{min(
          @page_number * @page_size,
          @filtered_alias_count
        )} of {@filtered_alias_count} aliases
      </p>
      <div class="flex w-full sm:w-auto items-center justify-between gap-1">
        <.link
          :if={@page_number > 1}
          id="alias-page-previous"
          patch={aliases_path(@page_number - 1, @filter_query)}
          class="px-3 py-2 rounded-md text-indigo-600 dark:text-indigo-400 hover:bg-gray-100 dark:hover:bg-gray-700"
        >
          Previous
        </.link>
        <span
          :if={@page_number == 1}
          aria-disabled="true"
          class="px-3 py-2 text-gray-400 dark:text-gray-500"
        >
          Previous
        </span>
        <p
          id="alias-page-summary"
          aria-live="polite"
          aria-atomic="true"
          class="sm:hidden text-gray-600 dark:text-gray-400"
        >
          Page {@page_number} of {@total_pages}
        </p>
        <div class="hidden sm:flex items-center gap-1">
          <%= for number <- @pagination_pages do %>
            <%= cond do %>
              <% number == :ellipsis -> %>
                <span aria-hidden="true" class="px-2 text-gray-500 dark:text-gray-400">…</span>
              <% number == @page_number -> %>
                <span
                  id={"alias-page-#{number}"}
                  aria-current="page"
                  aria-label={"Page #{number}"}
                  class="px-3 py-2 rounded-md bg-indigo-600 text-white"
                >
                  {number}
                </span>
              <% true -> %>
                <.link
                  id={"alias-page-#{number}"}
                  patch={aliases_path(number, @filter_query)}
                  aria-label={"Go to page #{number}"}
                  class="px-3 py-2 rounded-md text-indigo-600 dark:text-indigo-400 hover:bg-gray-100 dark:hover:bg-gray-700"
                >
                  {number}
                </.link>
            <% end %>
          <% end %>
        </div>
        <.link
          :if={@page_number < @total_pages}
          id="alias-page-next"
          patch={aliases_path(@page_number + 1, @filter_query)}
          class="px-3 py-2 rounded-md text-indigo-600 dark:text-indigo-400 hover:bg-gray-100 dark:hover:bg-gray-700"
        >
          Next
        </.link>
        <span
          :if={@page_number == @total_pages}
          aria-disabled="true"
          class="px-3 py-2 text-gray-400 dark:text-gray-500"
        >
          Next
        </span>
      </div>
    </nav>
  </div>
<% end %>
