<main class="max-w-xl mx-auto px-4 py-10">
  <section class="bg-white dark:bg-gray-800 rounded-lg shadow-sm p-6 space-y-5">
    <h1 class="text-2xl font-semibold">Connect {@details.name}?</h1>
    <p>{@details.name} will be able to:</p>
    <ul id="connection-permissions" class="list-disc pl-5 space-y-2">
      <li :for={permission <- Enum.map(@details.scopes, &Shroud.Mcp.permissions()[&1]) |> Enum.uniq()}>{permission}</li>
    </ul>
    <p class="text-sm text-gray-600 dark:text-gray-300">Your emails, real inbox address and account settings stay private.</p>
    <p class="text-sm text-gray-600 dark:text-gray-300">Disconnect anytime in Connected apps. Access expires after 90 days.</p>
    <.form for={to_form(%{"approval" => @approval})} action={~p"/oauth/authorize"} id="connection-consent" class="flex flex-wrap gap-3">
      <input type="hidden" name="approval" value={@approval} />
      <button name="decision" value="allow" class="btn btn-primary">Connect</button>
      <button name="decision" value="deny" class="btn btn-white">Cancel</button>
    </.form>
  </section>
</main>
