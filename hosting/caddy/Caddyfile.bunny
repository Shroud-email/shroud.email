{
  # Global options
  storage permissive_file_storage {
    root "/data"
  }

  email {$ADMIN_EMAIL}
}

{$APP_DOMAIN} {
  reverse_proxy web:8080
  tls {
    dns bunny {env.BUNNY_API_KEY}
  }
}

{$CAP_DOMAIN:disabled.localhost} {
  reverse_proxy cap:3000
  tls {
    dns bunny {env.BUNNY_API_KEY}
  }
}

{$EMAIL_DOMAIN} {
  tls {
    issuer acme
  }
}
