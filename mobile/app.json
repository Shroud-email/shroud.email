{
  "expo": {
    "name": "Shroud.email",
    "slug": "shroud-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "icon": "./assets/images/icon.png",
    "scheme": "shroud",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "email.shroud.app",
      "associatedDomains": ["applinks:app.shroud.email"],
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "email.shroud.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "https", "host": "app.shroud.email", "path": "/" },
            { "scheme": "https", "host": "app.shroud.email", "path": "/explore" },
            { "scheme": "https", "host": "app.shroud.email", "path": "/oauth/callback" }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#151726",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
