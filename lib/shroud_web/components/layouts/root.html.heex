<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="theme" content={if assigns[:current_user], do: to_string(@current_user.theme), else: "system"} />
    <meta name="paddle-client-token" content={Application.get_env(:shroud, :billing, [])[:paddle_client_token]} />
    <meta name="paddle-environment" content={Application.get_env(:shroud, :billing, [])[:paddle_environment]} />
    <script>
      (function() {
        var meta = document.querySelector('meta[name="theme"]');
        var pref = (meta && meta.content) || localStorage.getItem('shroud-theme') || 'system';
        var dark = pref === 'dark' || (pref === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>
    <%= csrf_meta_tag() %>
    <.live_title suffix=" · Shroud.email">
      <%= assigns[:page_title] || "Home" %>
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/fonts/inter/inter.css"}/>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"}/>
    <link phx-track-static rel="icon" href={~p"/favicon.ico"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}></script>
    <%= if Application.fetch_env!(:shroud, :app_domain) == "app.shroud.email" do %>
      <script
        defer
        data-domain="app.shroud.email"
        data-api="https://shroud.email/p/api/event"
        data-exclude="/alias/**, /domains/**, /users/confirm, /users/confirm/**, /email-report/**"
        src="https://shroud.email/p/pjs/script.exclusions.js"
      ></script>
    <% end %>
    <script src="https://uptime.betterstack.com/widgets/announcement.js" data-id="251784" async="async" type="text/javascript"></script>
    <script :if={chatwoot_base_url()} src={chatwoot_base_url() <> "/packs/js/sdk.js"} async></script>
  </head>
  <body
    class="h-full bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-gray-100"
    data-chatwoot-base-url={chatwoot_base_url()}
    data-current-user-email={if assigns[:current_user], do: @current_user.email}
    data-chatwoot-identifier-hash={chatwoot_identifier_hash(@current_user)}
  >
    <div class="min-h-full">
      <.navbar {assigns} />
      <%= @inner_content %>
    </div>
  </body>
</html>
