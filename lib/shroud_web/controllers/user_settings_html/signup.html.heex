<div>
  <div class="max-w-lg mx-auto rounded-lg shadow-sm dark:shadow-gray-900/50 overflow-hidden lg:max-w-none lg:flex">
    <div class="flex-1 bg-white dark:bg-gray-800 px-6 py-8 lg:px-12 lg:pb-12">
      <h3 class="text-2xl font-extrabold text-gray-900 dark:text-gray-100 sm:text-3xl">
        Upgrade to Pro
      </h3>
      <p class="mt-6 text-base text-gray-500 dark:text-gray-400">
        Unlock unlimited aliases, custom domains, and the ability to send emails from your aliases.
      </p>
      <div class="mt-8">
        <div class="flex items-center">
          <h4 class="shrink-0 pr-4 bg-white dark:bg-gray-800 text-sm tracking-wider font-semibold uppercase text-indigo-600 dark:text-indigo-400">
            What's included
          </h4>
          <div class="flex-1 border-t-2 border-gray-200 dark:border-gray-600"></div>
        </div>
        <ul role="list" class="mt-8 space-y-5 lg:space-y-0 lg:grid lg:grid-cols-2 lg:gap-x-8 lg:gap-y-5">
          <li class="flex items-start lg:col-span-1">
            <div class="shrink-0">
              <%!-- Heroicon name: solid/check-circle --%>
              <svg class="h-5 w-5 text-green-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            </div>
            <p class="ml-3 text-sm text-gray-700 dark:text-gray-300">
              Unlimited email aliases
            </p>
          </li>

          <li class="flex items-start lg:col-span-1">
            <div class="shrink-0">
              <%!-- Heroicon name: solid/check-circle --%>
              <svg class="h-5 w-5 text-green-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            </div>
            <p class="ml-3 text-sm text-gray-700 dark:text-gray-300">
              Advanced tracker blocking
            </p>
          </li>

          <li class="flex items-start lg:col-span-1">
            <div class="shrink-0">
              <svg class="h-5 w-5 text-green-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            </div>
            <p class="ml-3 text-sm text-gray-700 dark:text-gray-300">
              Custom domains
            </p>
          </li>

          <li class="flex items-start lg:col-span-1">
            <div class="shrink-0">
              <svg class="h-5 w-5 text-green-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            </div>
            <p class="ml-3 text-sm text-gray-700 dark:text-gray-300">
              Send emails from aliases
            </p>
          </li>
        </ul>
      </div>
    </div>
    <div class="py-8 px-6 text-center bg-gray-50 dark:bg-gray-700 lg:shrink-0 lg:flex lg:flex-col lg:justify-center lg:p-12">
      <p class="text-lg leading-6 font-medium text-gray-900 dark:text-gray-100">
        Billed yearly
      </p>
      <div class="mt-4 flex items-center justify-center text-5xl font-extrabold text-gray-900 dark:text-gray-100">
        <span>$35</span>
        <span class="ml-3 text-xl font-medium text-gray-500 dark:text-gray-400">
          USD
        </span>
      </div>
      <div class="mt-6">
        <div class="rounded-md shadow-sm">
          <button
            type="button"
            id="upgrade-button"
            class="flex items-center justify-center w-full px-5 py-3 border border-transparent text-base font-medium rounded-md text-white bg-gray-800 hover:bg-gray-900 dark:bg-indigo-600 dark:hover:bg-indigo-700"
            data-paddle-price-id={@paddle_price_id}
            data-customer-email={@current_user.email}
          >Upgrade</button>
        </div>
      </div>
    </div>
  </div>
</div>
