{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    },
    "exactOptionalPropertyTypes": false,
    "jsx": "preserve"
  },
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["edge-script", "dist"]
}
