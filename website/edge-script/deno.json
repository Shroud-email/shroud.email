{
  // Used by `deno task build` to bundle the edge script.
  "tasks": {
    "build": "mkdir -p dist && deno run -A build.mjs",
    "check": "deno check src/main.ts",
    "test": "deno test --allow-env=POSTHOG_CAPTURE_MODE src/",
    "dev": "deno run --allow-net --allow-read --allow-env=POSTHOG_CAPTURE_MODE src/main.ts"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
