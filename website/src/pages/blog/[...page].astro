---
import { isBefore } from "date-fns";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";

import LandingLayout from "../../layouts/LandingLayout.astro";
import PostPreview from "../../components/molecules/PostPreview.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("blog")).sort((a, b) => {
    if (isBefore(a.data.date, b.data.date)) return 1;
    if (isBefore(b.data.date, a.data.date)) return -1;
    return 0;
  });
  const [featured, ...olderPosts] = posts;
  return paginate(olderPosts, { pageSize: 3, props: { featured } });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<"blog">>;
  featured: CollectionEntry<"blog">;
}
const { page, featured } = Astro.props;
---

<LandingLayout
  title="Blog"
  description="Stay up to date with Shroud.email. Privacy news and product updates."
>
  <div
    class="bg-white dark:bg-slate-950 pt-8 mt-16 pb-20 px-4 sm:px-6 lg:pt-10 lg:pb-28 lg:px-8"
  >
    <div
      class="relative max-w-lg mx-auto lg:max-w-7xl"
    >
      <div>
        <h1
          class="text-3xl tracking-tight font-bold text-slate-900 dark:text-slate-50 sm:text-4xl font-display flex align-middle"
        >
          Blog
          <a
            href="/blog/rss.xml"
            class="ml-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-50 place-content-center pt-1"
          >
            <span class="sr-only">RSS</span>
            <!-- heroicons/outline rss -->
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M12.75 19.5V18.75C12.75 14.6079 9.39214 11.25 5.25 11.25H4.5M4.5 4.5H5.25C13.1201 4.5 19.5 10.8799 19.5 18.75V19.5M6 18.75C6 19.1642 5.66421 19.5 5.25 19.5C4.83579 19.5 4.5 19.1642 4.5 18.75C4.5 18.3358 4.83579 18 5.25 18C5.66421 18 6 18.3358 6 18.75Z"
                stroke="#0F172A"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </h1>
      </div>
      <div class="mt-6 pt-4">
        <section aria-label="Featured post">
          <PostPreview post={featured} featured />
        </section>
        <section aria-label="More posts" class="mt-10 grid gap-8 lg:grid-cols-3 lg:gap-5">
          {page.data.map((post) => <PostPreview post={post} />)}
        </section>
        <nav aria-label="Blog pagination" class="mt-10 flex items-center justify-between gap-4 text-sm">
          <div>
            {page.url.prev && (
              <a href={page.url.prev} rel="prev" class="inline-flex rounded-md border border-slate-300 dark:border-slate-700 px-4 py-2 font-medium text-slate-900 dark:text-slate-50 hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                ← Previous
              </a>
            )}
          </div>
          <span class="text-slate-500 dark:text-slate-400">Page {page.currentPage} of {page.lastPage}</span>
          <div>
            {page.url.next && (
              <a href={page.url.next} rel="next" class="inline-flex rounded-md border border-slate-300 dark:border-slate-700 px-4 py-2 font-medium text-slate-900 dark:text-slate-50 hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                Next →
              </a>
            )}
          </div>
        </nav>
        <p class="mt-10 flex items-start justify-center gap-3 text-base text-slate-700 dark:text-slate-300">
          <svg class="mt-0.5 h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12.75 19.5V18.75C12.75 14.6079 9.39214 11.25 5.25 11.25H4.5M4.5 4.5H5.25C13.1201 4.5 19.5 10.8799 19.5 18.75V19.5M6 18.75C6 19.1642 5.66421 19.5 5.25 19.5C4.83579 19.5 4.5 19.1642 4.5 18.75C4.5 18.3358 4.83579 18 5.25 18C5.66421 18 6 18.3358 6 18.75Z" />
          </svg>
          <span>
            Stay in the loop: subscribe to our <a href="/blog/rss.xml" class="font-bold text-slate-900 dark:text-slate-50 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded">RSS feed</a>.
          </span>
        </p>
      </div>
    </div>
  </div>
</LandingLayout>
