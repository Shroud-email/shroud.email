---
import "../styles/tailwind.css";
import { SEO } from "astro-seo";
import { OPEN_GRAPH, SITE } from "../config";
import PostHog from "../components/PostHog.astro";
import Chatwoot from "../components/Chatwoot.astro";

export interface Props {
    title?: string;
    description?: string;
}
let { title, description } = Astro.props;
title = title
    ? `${title} | ${SITE.title}`
    : `${SITE.title} | Email, meet privacy.`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const canonicalImageSrc = new URL(OPEN_GRAPH.image.src, Astro.site).toString();
const imageAlt = OPEN_GRAPH.image.alt;
---

<html
    class="h-full scroll-smooth antialiased [font-feature-settings:'ss01']"
    lang="en"
>
    <head>
        <meta charset="UTF-8" />
        <script is:inline>
            // Gate JS-driven motion (scroll reveals, rotating hero word) on a class
            // set before first paint. When absent — no JS, or reduced-motion — all
            // content renders visible and static. No flash, crawler-safe.
            if (
                window.matchMedia &&
                !window.matchMedia("(prefers-reduced-motion: reduce)").matches
            ) {
                document.documentElement.classList.add("motion-ok");
            }
        </script>
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="color-scheme" content="light dark" />
        <link
            rel="alternate"
            type="application/rss+xml"
            href="/blog/rss.xml"
            title="RSS"
        />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <link rel="canonical" href={canonicalURL} />

        <SEO
            title={title}
            description={description ?? SITE.description}
            openGraph={{
                basic: {
                    title: title,
                    type: "website",
                    image: canonicalImageSrc,
                    url: canonicalURL.toString(),
                },
                image: { url: canonicalImageSrc, alt: imageAlt },
                optional: {
                    siteName: SITE.title,
                    locale: OPEN_GRAPH.locale,
                },
            }}
            twitter={{
                card: "summary_large_image",
                title: title,
                description: description ?? SITE.description,
                image: canonicalImageSrc,
                imageAlt: imageAlt,
            }}
        />

        <slot name="head" />
    </head>

    <body class="h-full bg-white dark:bg-slate-950">
        <div class="h-full">
            <slot />
        </div>

        <PostHog />
        <Chatwoot />

        <script>
            // Scroll-reveal: toggle `is-visible` on .fade-in elements as they enter
            // the viewport. Only runs when motion is allowed (the `motion-ok` class is
            // set before first paint); otherwise the CSS keeps everything visible.
            if (document.documentElement.classList.contains("motion-ok")) {
                const io = new IntersectionObserver(
                    (entries) => {
                        for (const entry of entries) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("is-visible");
                                io.unobserve(entry.target);
                            }
                        }
                    },
                    { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
                );
                for (const el of document.querySelectorAll(".fade-in")) {
                    io.observe(el);
                }
            }
        </script>
    </body>
</html>
