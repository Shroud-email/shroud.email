---
import LandingLayout from "./LandingLayout.astro";
import { Image } from "astro:assets";
import { format, parseISO } from "date-fns";
import type { CollectionEntry } from "astro:content";

export type Props = CollectionEntry<"blog">["data"];
const { title, description, image, imageAlt, date } = Astro.props;

let formattedDate: string;
if (typeof date === "string") {
  formattedDate = format(parseISO(date), "PP");
} else {
  formattedDate = format(date, "PP");
}
---

<LandingLayout title={title} description={description}>
  <div class="relative mt-12 py-16 bg-white dark:bg-slate-950 overflow-hidden">
    <div class="hidden lg:block lg:absolute lg:inset-y-0 lg:h-full lg:w-full">
      <div
        class="relative h-full text-lg max-w-prose mx-auto"
        aria-hidden="true"
      >
        <svg
          class="absolute top-12 left-full transform translate-x-32"
          width="404"
          height="384"
          fill="none"
          viewBox="0 0 404 384"
        >
          <defs>
            <pattern
              id="74b3fd99-0a6f-4271-bef2-e80eeafdf357"
              x="0"
              y="0"
              width="20"
              height="20"
              patternUnits="userSpaceOnUse"
            >
              <rect
                x="0"
                y="0"
                width="4"
                height="4"
                class="text-slate-200 dark:text-slate-800"
                fill="currentColor"></rect>
            </pattern>
          </defs>
          <rect
            width="404"
            height="384"
            fill="url(#74b3fd99-0a6f-4271-bef2-e80eeafdf357)"></rect>
        </svg>
        <svg
          class="absolute top-1/2 right-full transform -translate-y-1/2 -translate-x-32"
          width="404"
          height="384"
          fill="none"
          viewBox="0 0 404 384"
        >
          <defs>
            <pattern
              id="f210dbf6-a58d-4871-961e-36d5016a0f49"
              x="0"
              y="0"
              width="20"
              height="20"
              patternUnits="userSpaceOnUse"
            >
              <rect
                x="0"
                y="0"
                width="4"
                height="4"
                class="text-slate-200 dark:text-slate-800"
                fill="currentColor"></rect>
            </pattern>
          </defs>
          <rect
            width="404"
            height="384"
            fill="url(#f210dbf6-a58d-4871-961e-36d5016a0f49)"></rect>
        </svg>
        <svg
          class="absolute bottom-12 left-full transform translate-x-32"
          width="404"
          height="384"
          fill="none"
          viewBox="0 0 404 384"
        >
          <defs>
            <pattern
              id="d3eb07ae-5182-43e6-857d-35c643af9034"
              x="0"
              y="0"
              width="20"
              height="20"
              patternUnits="userSpaceOnUse"
            >
              <rect
                x="0"
                y="0"
                width="4"
                height="4"
                class="text-slate-200 dark:text-slate-800"
                fill="currentColor"></rect>
            </pattern>
          </defs>
          <rect
            width="404"
            height="384"
            fill="url(#d3eb07ae-5182-43e6-857d-35c643af9034)"></rect>
        </svg>
      </div>
    </div>
    <div class="relative px-4 sm:px-6 lg:px-8">
      <Image
        src={image}
        alt={imageAlt}
        class="w-full max-w-prose mx-auto rounded-xl mb-12"
        layout="constrained"
        width={672}
        priority
      />
      <div class="text-lg max-w-prose mx-auto">
        <h1>
          <span
            class="mb-2 block text-3xl text-center leading-8 font-bold tracking-tight text-slate-900 dark:text-slate-50 sm:text-4xl font-display"
            >{title}</span
          >
        </h1>
        <span
          class="block text-base text-center text-indigo-600 dark:text-indigo-400 font-semibold tracking-wide uppercase"
          >{formattedDate}</span
        >
        <p class="mt-8 text-xl text-slate-800 dark:text-slate-300 leading-8">
          {description}
        </p>
      </div>
      <div class="mt-6 prose prose-indigo dark:prose-invert prose-lg text-slate-800 dark:text-slate-300 mx-auto">
        <slot />
      </div>
    </div>
  </div>
</LandingLayout>
