---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

export interface Props {
  post: CollectionEntry<"blog">;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
---

<a
  href={`/blog/${post.id}/`}
  class:list={[
    "flex flex-col rounded-lg shadow-lg overflow-hidden focus:ring focus:ring-indigo-600",
    featured && "relative lg:grid lg:grid-cols-2",
  ]}
>
  {featured && (
    <span class="absolute top-4 right-4 z-10 rounded-full bg-indigo-600 px-3 py-1 text-xs font-semibold text-white shadow-sm">
      Featured
    </span>
  )}
  <div class="shrink-0">
    <Image
      src={post.data.image}
      alt={post.data.imageAlt}
      data-featured-image={featured ? "true" : undefined}
      priority={featured}
      class:list={["w-full object-cover", featured ? "h-64 lg:h-80" : "h-48"]}
      layout="full-width"
      widths={featured ? [480, 640, 768, 1024, 1280] : [320, 480, 640, 768]}
      sizes={featured
        ? "(min-width: 1280px) 608px, (min-width: 1024px) calc((100vw - 4rem) / 2), (min-width: 640px) 512px, calc(100vw - 2rem)"
        : "(min-width: 1280px) 395px, (min-width: 1024px) calc((100vw - 5rem) / 3), (min-width: 640px) 512px, calc(100vw - 2rem)"}
      loading={featured ? "eager" : "lazy"}
      decoding="async"
    />
  </div>
  <div class:list={[
    "flex-1 bg-white dark:bg-slate-900 p-6 flex flex-col",
    featured ? "justify-center lg:p-10" : "justify-between",
  ]}>
    <div>
      <p class:list={[
        "font-semibold text-slate-900 dark:text-slate-50 font-display",
        featured ? "text-3xl sm:text-4xl" : "text-xl",
      ]}>
        {post.data.title}
      </p>
    </div>
    <p class="mt-3 text-base text-slate-500 dark:text-slate-400">{post.data.description}</p>
  </div>
</a>
