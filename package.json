{
  "name": "shroud.email",
  "scripts": {
    "test": "node --test shroud.email/assets/js/*_test.mjs",
    "format": "prettier --write '**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}'",
    "format:check": "prettier --check '**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}'",
    "prepare": "git config --local core.hooksPath .lefthook && mise exec -- lefthook install --force"
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
