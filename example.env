APP_DOMAIN=example.com
EMAIL_DOMAIN=mail.example.com
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=shroud
DB_ENCRYPTION_KEY=replaceme
SECRET_KEY_BASE=<run mix phx.gen.secret>
SMTP_RELAY=localhost
SMTP_PORT=25
SMTP_TLS=always
SMTP_AUTH=always
SMTP_USERNAME=shroudemail
SMTP_PASSWORD=abc
# Paddle Billing (https://developer.paddle.com)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_YEARLY_PRICE_ID=
# Override to https://sandbox-api.paddle.com for the sandbox
PADDLE_BASE_URL=https://api.paddle.com
# Client-side token for Paddle.js (Developer tools > Authentication). test_ prefix for sandbox.
PADDLE_CLIENT_TOKEN=
# Set to sandbox for the sandbox environment; defaults to live
PADDLE_ENVIRONMENT=live
LOOPS_API_KEY=abc
LOOPS_ACTIVE_USERS_LIST_ID=abc
# Chatwoot support widget. Set CHATWOOT_BASE_URL to your Chatwoot
# server to enable the widget; leave unset for self-hosted deployments
# that don't want it. CHATWOOT_HMAC_TOKEN is optional identity validation.
CHATWOOT_BASE_URL=https://support.example.com
CHATWOOT_HMAC_TOKEN=abc
AWS_ACCESS_KEY_ID=abc
AWS_SECRET_ACCESS_KEY=abc
S3_BUCKET=abc
S3_HOST=abc

# Cap CAPTCHA (optional). Set all three to enable Cap on the signup,
# login, and password-reset forms. Leave unset to disable (forms work
# without Cap). See docker-compose.yaml for the cap + valkey services.
# CAP_ADMIN_KEY: required by the `cap` docker service at boot (dashboard
# password). Generate with: openssl rand -hex 32
CAP_ADMIN_KEY=
# CAP_INSTANCE_URL: the PUBLIC, browser-reachable HTTPS URL of your Cap
# instance (the widget renders this into data-cap-api-endpoint, so a
# user's browser must reach it over HTTPS). http://localhost:3000 works
# for LOCAL dev only; in production use e.g. https://cap.yourdomain.com.
CAP_INSTANCE_URL=
CAP_SITE_KEY=
CAP_SECRET_KEY=
